generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum RoleName { ADMINISTRATOR IT_SUPPORT STAFF_USER }
enum HealthStatus { HEALTHY DEGRADED OFFLINE UNKNOWN }
enum DeploymentStatus { QUEUED CLONING BUILDING DEPLOYING HEALTH_CHECK SUCCEEDED FAILED CANCELLED }
enum Severity { INFORMATION WARNING ERROR CRITICAL }

model Role { id String @id @default(cuid()) name RoleName @unique users User[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model User { id String @id @default(cuid()) supabaseId String @unique email String @unique name String roleId String role Role @relation(fields:[roleId], references:[id]) suspendedAt DateTime? applicationAccess ApplicationAccess[] auditLogs AuditLog[] notifications Notification[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([roleId]) }
model Application { id String @id @default(cuid()) name String slug String @unique domain String @unique repository String branch String @default("main") framework String environment String @default("production") port Int serverId String? server Server? @relation(fields:[serverId], references:[id]) health HealthStatus @default(UNKNOWN) deployments Deployment[] databases Database[] backups Backup[] metrics Metric[] logs Log[] variables EnvironmentVariable[] access ApplicationAccess[] alerts Alert[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([serverId,health]) }
model ApplicationAccess { userId String applicationId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@id([userId,applicationId]) }
model Deployment { id String @id @default(cuid()) applicationId String application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade) commitSha String? branch String status DeploymentStatus @default(QUEUED) imageTag String? startedAt DateTime? completedAt DateTime? errorMessage String? createdAt DateTime @default(now()) @@index([applicationId,createdAt]) @@index([status]) }
model Server { id String @id @default(cuid()) name String @unique provider String region String ipAddress String @unique operatingSystem String cpuCores Int ramMb Int storageMb Int health HealthStatus @default(UNKNOWN) monthlyCost Decimal @db.Decimal(10,2) applications Application[] metrics Metric[] logs Log[] alerts Alert[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([health]) }
model Database { id String @id @default(cuid()) name String @unique applicationId String? application Application? @relation(fields:[applicationId],references:[id]) status HealthStatus @default(UNKNOWN) sizeBytes BigInt @default(0) activeConnections Int @default(0) credentialRef String backups Backup[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([applicationId,status]) }
model Backup { id String @id @default(cuid()) name String applicationId String? application Application? @relation(fields:[applicationId],references:[id]) databaseId String? database Database? @relation(fields:[databaseId],references:[id]) type String status String sizeBytes BigInt storageKey String retentionUntil DateTime? createdAt DateTime @default(now()) @@index([applicationId,createdAt]) @@index([databaseId,createdAt]) }
model Metric { id BigInt @id @default(autoincrement()) applicationId String? application Application? @relation(fields:[applicationId],references:[id]) serverId String? server Server? @relation(fields:[serverId],references:[id]) name String value Float unit String recordedAt DateTime @default(now()) @@index([applicationId,name,recordedAt]) @@index([serverId,name,recordedAt]) }
model Log { id BigInt @id @default(autoincrement()) applicationId String? application Application? @relation(fields:[applicationId],references:[id]) serverId String? server Server? @relation(fields:[serverId],references:[id]) category String severity Severity @default(INFORMATION) message String metadata Json? createdAt DateTime @default(now()) @@index([applicationId,createdAt]) @@index([serverId,createdAt]) @@index([severity,createdAt]) }
model Alert { id String @id @default(cuid()) applicationId String? application Application? @relation(fields:[applicationId],references:[id]) serverId String? server Server? @relation(fields:[serverId],references:[id]) title String severity Severity status String @default("OPEN") resolvedAt DateTime? createdAt DateTime @default(now()) @@index([status,severity,createdAt]) }
model EnvironmentVariable { id String @id @default(cuid()) applicationId String application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade) key String encryptedValue String keyVersion Int @default(1) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([applicationId,key]) }
model AuditLog { id BigInt @id @default(autoincrement()) userId String? user User? @relation(fields:[userId],references:[id]) action String resourceType String resourceId String? ipAddress String? metadata Json? createdAt DateTime @default(now()) @@index([userId,createdAt]) @@index([resourceType,resourceId]) }
model Invoice { id String @id @default(cuid()) number String @unique periodStart DateTime periodEnd DateTime amount Decimal @db.Decimal(10,2) currency String @default("MYR") status String downloadKey String? createdAt DateTime @default(now()) @@index([periodStart,periodEnd]) }
model Notification { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) title String body String readAt DateTime? createdAt DateTime @default(now()) @@index([userId,readAt,createdAt]) }
